catalog <- read.txt("data/raw/2026-07-10_scedc-scsn_socal_2010-2025_raw.txt")
cat <- read.table(
"data/raw/2026-07-10_scedc-scsn_socal_2010-2025_raw.txt",
header = FALSE,        # set TRUE if there's a real column-name row
comment.char = "#",    # skips SCEDC header lines
fill = TRUE,           # tolerates ragged rows
stringsAsFactors = FALSE
)
head(cat)
f <- "data/raw/2026-07-10_scedc-scsn_socal_2010-2025_raw.txt"
lines <- readLines(f)
# keep only lines that start with a date like 2010/01/01
data_lines <- grep("^\\s*\\d{4}/\\d{2}/\\d{2}", lines, value = TRUE)
cat <- read.table(text = data_lines, header = FALSE, fill = TRUE,
stringsAsFactors = FALSE)
colnames(cat) <- c("date","time","et","gt","mag","magtype",
"lat","lon","depth","q","evid","nph","ngrm")
head(cat)
summary(cat$et)
table(cat$et)
table(cat$M)
table(cat$magtype)
table(cat$q)
head(f)
cat <- read.table(
+     "data/raw/2026-07-10_scedc-scsn_socal_2010-2025_raw.txt",
+     header = FALSE,        # set TRUE if there's a real column-name row
375993-358988
